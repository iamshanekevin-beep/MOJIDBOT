# Base44 placeholder defaults — let the app boot before real credentials arrive.
# Real secrets (IQ_EMAIL, IQ_PASSWORD) are delivered via /run/base44/app.env and override these.

IQ_EMAIL=placeholder@example.com
IQ_PASSWORD=placeholder
ACCOUNT_TYPE=PRACTICE

# Multi-pair: comma-separated list
PAIRS=EURUSD-OTC
TIMEFRAME_SECONDS=60
CANDLE_COUNT=100
EXPIRATION_MINUTES=1

# Higher timeframe for trend analysis (1h)
HIGHER_TIMEFRAME_SECONDS=3600
HIGHER_TIMEFRAME_CANDLES=50

# Doji filter: body must be > 10% of candle range
DOJI_THRESHOLD=0.1

STRATEGY=BOTH
FCB_FRACTAL_PERIOD=2

EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_UP=55
RSI_DOWN=45
CCI_PERIOD=14
CCI_UP=100
CCI_DOWN=-100
BB_PERIOD=20
BB_STD=2.0
POLE_POSITION_SCORE_THRESHOLD=3

TRADE_AMOUNT=1.0
MAX_CONSECUTIVE_LOSSES=3
MAX_TRADES_PER_DAY=0
DAILY_LOSS_LIMIT=0

AUTO_TRADE=true
POLL_SECONDS=5
